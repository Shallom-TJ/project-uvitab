rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated (including Firebase Anonymous auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check ownership matching the document's ownerId
    function isOwner(resourceData) {
      return isAuthenticated() && (request.auth.uid == resourceData.ownerId);
    }

    // Resources collection (Lecture notes, past papers, summaries, self-tests)
    match /resources/{resourceId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }

    // Tutors collection
    match /tutors/{tutorId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }

    // Courses collection
    match /courses/{courseId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Tutor bookings collection
    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Meta collection (seeding status)
    match /meta/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
