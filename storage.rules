rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin check via custom claims (Storage rules cannot query Firestore)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.superAdmin == true
      );
    }

    // Check if user is the resource owner using customMetadata.ownerId
    function isOwnerByMetadata() {
      return isAuthenticated() &&
             resource.metadata != null &&
             resource.metadata.ownerId == request.auth.uid;
    }

    // Require customMetadata.ownerId equal to request.auth.uid on creation (unless Admin)
    function isOwnerOnCreate() {
      return isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.metadata != null &&
          request.resource.metadata.ownerId == request.auth.uid
        )
      );
    }

    // ── Academic resources ─────────────────────────────────────────────
    match /resources/{allPaths=**} {
      // Public read of resources (Firestore rules control visibility; Storage serves files)
      allow read: if true;

      // Upload: authenticated users with ownership metadata, max 150MB, allowed document/media MIME types
      allow create: if isOwnerOnCreate() &&
                       request.resource.size <= 150 * 1024 * 1024 &&
                       (
                         request.resource.contentType.matches('application/pdf') ||
                         request.resource.contentType.matches('application/msword') ||
                         request.resource.contentType.matches('application/vnd\\..*') ||
                         request.resource.contentType.matches('application/zip') ||
                         request.resource.contentType.matches('application/octet-stream') ||
                         request.resource.contentType.matches('text/.*') ||
                         request.resource.contentType.matches('audio/.*') ||
                         request.resource.contentType.matches('video/.*')
                       );

      allow update: if isOwnerByMetadata() || isAdmin();

      // STRICT: Only the verified owner (via customMetadata) or an Admin can delete
      allow delete: if isAdmin() || isOwnerByMetadata();
    }

    // ── Tutor profile photos ───────────────────────────────────────────
    match /tutor-photos/{allPaths=**} {
      allow read: if true;

      // Upload: authenticated users with ownership metadata, max 10MB, image MIME types
      allow create: if isOwnerOnCreate() &&
                       request.resource.size <= 10 * 1024 * 1024 &&
                       request.resource.contentType.matches('image/.*');

      allow update: if isOwnerByMetadata() || isAdmin();

      allow delete: if isAdmin() || isOwnerByMetadata();
    }
  }
}
