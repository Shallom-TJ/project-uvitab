# =========================================================
# VU NOTES — Server Environment Configuration Template
# Victoria University Uganda Student Resource Platform
#
# INSTRUCTIONS:
# 1. Copy this file to `server/.env`:
#      cp .env.example server/.env
# 2. Fill in your Firebase Admin SDK credentials below.
# 3. DO NOT commit your real .env or private key files to Git.
# =========================================================

# Server Port and Environment
PORT=5001
NODE_ENV=development

# ---------------------------------------------------------
# OPTION A: Individual Firebase Service Account Environment Variables
# (Recommended for production hosting platforms like Render, Railway, Fly.io, etc.)
# ---------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Note: For private keys with newlines, keep surrounding quotes and \n:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------
# OPTION B: Path to Service Account JSON Key File
# (Common for local development)
# Download from Firebase Console → Project Settings → Service accounts → Generate new private key
# ---------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ---------------------------------------------------------
# Primary Super Admin Account
# ---------------------------------------------------------
ADMIN_EMAIL=admin@vunotes.ac.ug
